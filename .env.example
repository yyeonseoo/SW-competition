# Optional: only required for image-based notices that use CLOVA OCR.
CLOVA_OCR_URL=
CLOVA_OCR_SECRET=

# Required for notice structuring and embedding generation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Comma-separated frontend origins allowed to call the FastAPI server.
CORS_ORIGINS=http://localhost:3000

# Optional sanitized SQLite seed copied on the first server start.
DEPLOY_SEED_DB=deploy_seed.db
